{
  "name": "star-browser",
  "version": "0.3.0",
  "private": true,
  "description": "Star Browser · 独立浏览环境与高频工作台",
  "main": "src/main/main.js",
  "author": "Star Browser",
  "license": "MIT",
  "tfbMode": "changyi",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "test": "node --test tests/unit.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:package": "node tests/package-smoke.cjs",
    "verify:source": "node scripts/verify-source.cjs",
    "build:mac": "npm run build:ui && electron-builder --mac --arm64 --publish never",
    "build:mac:intel": "npm run build:ui && electron-builder --mac --x64 --publish never",
    "build:ui": "node scripts/build-ui.cjs",
    "build:icon": "node scripts/build-icon.cjs",
    "test:scale": "node tests/workbench-scale.cjs",
    "test:permissions": "node tests/permissions.cjs",
    "test:extensions": "node tests/extensions.cjs",
    "test:api": "node tests/local-api.cjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "@radix-ui/react-tabs": "1.2.0",
    "7zip-bin": "5.2.0",
    "cmdk": "1.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "1.55.0",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "build": {
    "appId": "com.starbrowser.desktop",
    "productName": "Star Browser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Star-Browser-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Star Browser ${version}"
    }
  }
}
